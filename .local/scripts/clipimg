#!/usr/bin/env zsh
# clipimg - save clipboard image to file
# usage: clipimg [-vp|-vw] [filename] [path]
#
# options:
#   [filename]      optional output filename (default: timestamp.png)
#   [path]          optional save location (default: current directory)
#   -vp, --vaultp   save to personal vault assets/imgs
#   -vw, --vaultw   save to work vault assets/imgs
#   -h, --help      show this message

set -euo pipefail

VAULT_PATH_PERSONAL="$HOME/vault/personal/assets/imgs"
VAULT_PATH_WORK="$HOME/vault/work/assets/imgs"

show_help() {
  cat <<'EOF'
clipimg - save clipboard image to file
usage: clipimg [-vp|-vw] [filename] [path]

options:
  [filename]      optional output filename (default: timestamp.png)
  [path]          optional save location (default: current directory)
  -vp, --vaultp   save to personal vault assets/imgs
  -vw, --vaultw   save to work vault assets/imgs
  -h, --help      show this message
EOF
  exit 0
}

SAVE_DIR="$(pwd)"
FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      show_help
      ;;
    -vp|--vaultp)
      SAVE_DIR="$VAULT_PATH_PERSONAL"
      ;;
    -vw|--vaultw)
      SAVE_DIR="$VAULT_PATH_WORK"
      ;;
    -*)
      echo "unknown option: $1" >&2
      exit 1
      ;;
    *)
      if [[ -z "$FILE" ]]; then
        FILE="$1"
      else
        SAVE_DIR="$1"
      fi
      ;;
  esac
  shift
done

FILE="${FILE:-$(date +%Y%m%d-%H%M%S).png}"
[[ "$FILE" == *.png ]] || FILE="${FILE}.png"

mkdir -p "$SAVE_DIR"

WIN_PATH="$(wslpath -w "$SAVE_DIR/$FILE")"

powershell.exe -NoProfile -Command "
  \$img = Get-Clipboard -Format Image
  if (\$null -ne \$img) {
    \$img.Save('$WIN_PATH')
    Write-Host 'Saved: $WIN_PATH'
  } else {
    Write-Host 'No image in clipboard'
    exit 1
  }
"
